    sensitivity_holding_shape = []
    for k_mult in [0.5, 1.0, 2.0]:
        row = {'gamma_shape_multiplier': k_mult}
        for intv in ['B0_baseline', 'I1_routing_continuity', 'I2_rework_prevention', 'I3_targeted_intake']:
